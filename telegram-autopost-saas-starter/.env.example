APP_ENV=development
APP_NAME=telegram-autopost-saas
LOG_LEVEL=INFO

POSTGRES_DB=autopost
POSTGRES_USER=autopost
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

BOT_TOKEN=replace-with-bot-token

# Telegram user authorization (do NOT commit real values)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Optional future admin IDs, comma-separated
OWNER_TELEGRAM_IDS=

# Secret used by the bot/scheduler to call internal backend endpoints
INTERNAL_API_SECRET=replace-with-long-random-secret
BACKEND_URL=http://api:8000
